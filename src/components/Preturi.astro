---
import { type Lang, t } from '../content/i18n';
import { PRETURI, CONTACT } from '../content/shared';
import Icon from './Icon.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = t(lang);
---
<section class="section section--alt" id="preturi">
  <div class="wrap">
    <div class="section__head" data-reveal>
      <span class="eyebrow">03</span>
      <h2 class="section__title">{c.preturi.titlu}</h2>
      <p class="section__intro">{c.preturi.intro}</p>
    </div>

    <ul class="pre">
      {c.preturi.lista.map((p, i) => (
        <li class:list={['pre__c card', { 'pre__c--star': i === 0 }]} data-reveal style={`--reveal-delay:${i * 90}ms`}>
          <span class="pre__nume">{p.nume}</span>
          <span class="pre__val">
            <span class="pre__nr">{p.pret}</span>
            <span class="pre__mon">{PRETURI.moneda}</span>
          </span>
          <span class="pre__det">{p.detaliu}</span>
        </li>
      ))}
    </ul>

    <div class="pre__jos" data-reveal>
      <p class="pre__inclus">
        <Icon name="cort" size={17} />
        <span>{c.preturi.inclus}</span>
      </p>
      <p class="pre__nota">{c.preturi.nota}</p>
      <a class="btn btn--primary" href={`tel:${CONTACT.telefonRaw}`}>
        <Icon name="telefon" size={16} class="btn__icon" />
        <span>{CONTACT.telefon}</span>
      </a>
    </div>
  </div>
</section>

<style>
  .pre {
    display: grid;
    gap: clamp(1rem, 2.4vw, 1.4rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
  }
  .pre__c {
    display: grid;
    gap: var(--sp-2);
    padding: clamp(1.4rem, 3.2vw, 2rem);
    text-align: center;
    position: relative;
    transition: transform .3s var(--ease), box-shadow .3s var(--ease);
  }
  .pre__c:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
  .pre__c--star { border-color: var(--primary); box-shadow: 0 0 0 1px var(--primary), var(--shadow-sm); }

  .pre__nume {
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: .11em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .pre__val { display: flex; align-items: baseline; justify-content: center; gap: .3rem; }
  .pre__nr {
    font-family: var(--font-display);
    font-size: var(--t-2xl);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -.03em;
    color: var(--primary);
    font-variant-numeric: tabular-nums;
  }
  .pre__mon { font-size: var(--t-sm); font-weight: 600; color: var(--ink-3); }
  .pre__det { font-size: var(--t-xs); color: var(--ink-3); line-height: 1.45; }

  .pre__jos {
    display: grid;
    justify-items: center;
    gap: var(--sp-4);
    margin-top: clamp(2rem, 5vw, 3rem);
    text-align: center;
  }
  .pre__inclus {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    padding: .45rem 1rem;
    border-radius: var(--r-full);
    background: var(--accent-soft);
    color: var(--accent);
    font-size: var(--t-sm);
    font-weight: 600;
  }
  .pre__nota { max-width: 56ch; color: var(--ink-2); font-size: var(--t-sm); line-height: 1.6; }
</style>
