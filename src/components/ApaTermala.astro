---
import { Image } from 'astro:assets';
import { type Lang, t } from '../content/i18n';
import imgApa from '../assets/photos/apa-termala.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = t(lang);

const alt = lang === 'ro'
  ? 'Jeturi de apă termală care se varsă în bazin'
  : 'Termálvíz-sugarak ömlenek a medencébe';
---
<section class="section section--alt apa" id="apa">
  <div class="wrap apa__grid">
    <figure class="apa__fig" data-reveal>
      <Image
        src={imgApa}
        alt={alt}
        widths={[420, 686]}
        sizes="(min-width: 900px) 44vw, 100vw"
        quality={82}
        class="apa__img"
      />
    </figure>

    <div class="apa__txt" data-reveal style="--reveal-delay:120ms">
      <span class="eyebrow">{c.apa.supratitlu}</span>
      <h2 class="section__title">{c.apa.titlu}</h2>
      {c.apa.paragrafe.map((p) => <p class="apa__p">{p}</p>)}

      <ul class="cifre">
        {c.apa.cifre.map((x) => (
          <li class="cifre__i">
            <span class="cifre__v">{x.valoare}</span>
            <span class="cifre__e">{x.eticheta}</span>
          </li>
        ))}
      </ul>

      <p class="apa__note">{c.apa.disclaimer}</p>
    </div>
  </div>
</section>

<style>
  .apa__grid {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .apa__fig { margin: 0; border-radius: var(--r-xl); overflow: hidden; box-shadow: var(--shadow-md); }
  .apa__img { width: 100%; height: 100%; object-fit: cover; aspect-ratio: 1 / 1; }

  .apa__p { margin-top: var(--sp-5); color: var(--ink-2); font-size: var(--t-md); line-height: 1.62; }
  .apa__p:first-of-type { margin-top: var(--sp-5); }

  .cifre {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-4);
    margin-top: var(--sp-6);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--line-strong);
  }
  .cifre__i { display: grid; gap: .25rem; }
  .cifre__v {
    font-family: var(--font-display);
    font-size: var(--t-xl);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -.02em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .cifre__e { font-size: var(--t-xs); color: var(--ink-3); line-height: 1.35; }

  .apa__note {
    margin-top: var(--sp-6);
    padding: var(--sp-4);
    border-left: 3px solid var(--line-strong);
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    border-radius: 0 var(--r-sm) var(--r-sm) 0;
    font-size: var(--t-xs);
    color: var(--ink-3);
    line-height: 1.55;
  }

  @media (min-width: 900px) {
    .apa__grid { grid-template-columns: 0.85fr 1fr; }
  }
</style>
